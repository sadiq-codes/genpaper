# =============================================================================
# Docker Ignore File
# Excludes files not needed in Docker builds
# =============================================================================

# Dependencies (will be installed fresh in Docker)
node_modules
.pnp
.pnp.js

# Build outputs (will be built fresh)
.next
out
dist
build

# Testing
coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
__mocks__

# Development
.env*.local
.env.development
.env.test
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea
.vscode
*.swp
*.swo
.DS_Store

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*
.docker

# Documentation
*.md
!README.md
docs

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Misc
.turbo
.vercel
.cache
*.tsbuildinfo

# Supabase local
supabase/.temp

# Scripts not needed in production
scripts/bulk-ingest*.ts
scripts/backfill*.ts
scripts/discover*.ts
scripts/test*.ts

# Progress files
.bulk-ingest-*.json
.backfill-*.json
.pdf-domain-*.json

# Logs
*.log
logs

# Temporary files
tmp
temp
