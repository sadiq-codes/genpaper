# =============================================================================
# GenPaper Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

# -----------------------------------------------------------------------------
# Supabase (Required)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# -----------------------------------------------------------------------------
# AI Providers (Required - at least one)
# -----------------------------------------------------------------------------
# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Polar Billing (Required for paid features)
# Get these from: https://polar.sh/dashboard
# -----------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=polar_at_...
POLAR_WEBHOOK_SECRET=whsec_...
POLAR_ORGANIZATION_ID=org_...

# Product IDs from Polar dashboard
POLAR_PRODUCT_STARTER=prod_...
POLAR_PRODUCT_RESEARCHER=prod_...
POLAR_PRODUCT_INSTITUTION=prod_...

# -----------------------------------------------------------------------------
# Academic APIs (Optional - improves paper search quality)
# -----------------------------------------------------------------------------
# Semantic Scholar - https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# CORE - https://core.ac.uk/services/api
CORE_API_KEY=

# -----------------------------------------------------------------------------
# Embedding Provider (1024 dimensions required)
# -----------------------------------------------------------------------------
# Database is configured for 1024-dimension embeddings (BGE-large-en-v1.5)
# Choose ONE of the following options:

# Option 1: Self-hosted embedding server (RECOMMENDED for bulk ingestion)
# Uses BAAI/bge-large-en-v1.5 model (1024 dimensions)
# Deploy using: docker run -p 8787:8787 ghcr.io/huggingface/text-embeddings-inference:cpu-1.5.0 --model-id BAAI/bge-large-en-v1.5
# EMBEDDING_SERVER_URL=http://your-server:8787
# EMBEDDING_API_TOKEN=optional-auth-token

# Option 2: Direct OpenAI (fallback)
# Uses text-embedding-3-small with dimensions=1024
# No extra config needed - uses OPENAI_API_KEY above

# NOTE: Azure OpenAI is NOT supported for embeddings because it produces
# 1536 dimensions which doesn't match our 1024 dim database schema.

# -----------------------------------------------------------------------------
# PDF Processing (Optional)
# -----------------------------------------------------------------------------
# GROBID server URL for PDF extraction
# Leave empty to use basic PDF extraction
GROBID_URL=

# -----------------------------------------------------------------------------
# Email & Support (Optional)
# -----------------------------------------------------------------------------
CONTACT_EMAIL=support@your-domain.com

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable debug logging
DEBUG=false

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
# Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
